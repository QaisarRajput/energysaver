{
  "name": "energysaver",
  "private": true,
  "scripts": {
    "build": "pnpm --filter web run build",
    "dev": "pnpm --filter web run dev",
    "generate-assets": "tsx scripts/generate-assets.ts",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "validate": "pnpm --filter etl run validate",
    "test": "pnpm --filter web run test",
    "prebuild": "pnpm validate && pnpm typecheck"
  },
  "dependencies": {
    "@energysaver/schema": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
